# Inspect the output files: .opi (gene-info), .oii (individual info)
system(' cd /output/ | ls')
# Inspect the output files: .opi (gene-info), .oii (individual info)
system(' cd ~output/ | ls')
# Inspect the output files: .opi (gene-info), .oii (individual info)
system(' cd output~ | ls')
# Inspect the output files: .opi (gene-info), .oii (individual info)
system(' cd ouput/')
# Inspect the output files: .opi (gene-info), .oii (individual info)
system(' cd output/')
# Inspect the output files: .opi (gene-info), .oii (individual info)
system(' cd output/ ; ls')
# Inspect the output files: .opi (gene-info), .oii (individual info)
system(' cd output/ ; head *.opi')
# Update .opi file to store extra information for genes - END START etc.
system('./osca_Mac --befile output/ge.profile2 --update-opi input/ge.opi')
system(' cd output/ ; head ge.profile2.opi')
system('./osca_Mac --eqtl --bfile input/genotypes.chr1 --befile output/ge.profile2 --cis --cis-wind 1000 --thread-num 10 --out output/cis.eqtls.chr1')
# Query the .besd file  to extract the eqtls at the specified threshold.
system('./osca_Mac --beqtl-summary output/cis.eqtls.chr1  --query 5e-8 --out output/eqtls.5e-8.txt')
eqtls <- read.table('output/eqtls.5e-8.txt', header = T)
# 1.
system('cd output/ ; cat *.besd | wc -l')
system('cd output/ ; head *.besd')
system('cd output/ ; head *.besd')
system('cd output/ ; head cis.eqtls.chr1.besd')
system('cd output/ ; tail cis.eqtls.chr1.besd')
cat('Number of eqtls : ', nrow(eqtls))
cat('Number of eGenes : ', unique(eqtls$Gene))
cat('Number of eGenes : ', length(unique(eqtls$Gene)))
cat('Number of eqtls : ', nrow(eqtls))
# 3.
eqtls %>%
group_by(Gene) %>%
slice(which.min(p))
