# Explained variation for each PC.
pca.object.var <-  geno.pca$sdev^2 # variance
pca.object.var.per <-  round(pca.object.var/sum(pca.object.var)*100, 1) # percentage of explained variance
barplot(pca.object.var.per[1:10], main="Explained variance for PC1-10",
xlab="PC",
ylab="Percent Variation (%)",
xlim=c(0, 11),
ylim=c(0, 100))
